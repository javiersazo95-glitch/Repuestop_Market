# URL base de la API del backend Spring Boot (RespuesTop-mono-repo/backend).
#
# Desarrollo local: el backend levanta en el 8080 (server.port=${PORT:8080}) y su
# allowlist CORS de desarrollo ya incluye http://localhost:5173, que es el puerto
# de Vite en este repo.
VITE_API_URL=http://localhost:8080/api/v1

# Producción: apuntar al dominio real de la API. El origen desde el que se sirva
# este marketplace debe estar en CORS_ALLOWED_ORIGINS del backend
# (ver application-prod.properties), o el navegador bloqueará las llamadas.
# VITE_API_URL=https://api.repuestop.cl/api/v1

# DSN del proyecto "React" en Sentry (organización Corebit SpA, región US).
# Sin esta variable, src/sentry.js no inicializa nada: en dev local no se
# manda ningun error, a proposito, para no gastar la cuota gratuita
# (5k eventos/mes) con errores mientras se programa. Se configura solo en
# las variables de entorno de Vercel (dev y main), nunca en este archivo.
# VITE_SENTRY_DSN=https://xxxxx@oXXXXXXXXXXXXXXXX.ingest.us.sentry.io/XXXXXXXXXXXXXXXX
